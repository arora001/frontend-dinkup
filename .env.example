# DinkUp Frontend Environment Variables

# Backend API Base URL (NestJS running at localhost:5003)
NEXT_PUBLIC_API_URL=http://localhost:5003/api/v1

# Realtime WebSocket URL (NestJS Socket.IO gateway on /realtime)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5003

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
